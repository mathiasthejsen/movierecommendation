# Copy to .env.local for local development. Never commit real values.
# Everything prefixed NEXT_PUBLIC_ is baked into the public static site.

# ---------- Web app (public, build-time) ----------
# Base path for GitHub Pages project sites, e.g. /movie-recommender (empty for local dev / custom domain)
NEXT_PUBLIC_BASE_PATH=
# Supabase project URL and the anon / publishable key (safe to expose; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional override; defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1/tmdb-proxy
NEXT_PUBLIC_TMDB_PROXY_URL=

# ---------- Data pipeline (secret; GitHub Actions secrets) ----------
TMDB_API_KEY=
# or a v4 read access token instead of the v3 key:
TMDB_READ_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional for script apps (password grant); leave empty to use app-only OAuth
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=personal-movie-recommender/0.1 (by u/your_username)
# Optional sources
TRAKT_CLIENT_ID=
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional LLM title extractor hook: module:function (see pipeline/extract.py)
LLM_EXTRACTOR=

# ---------- Pipeline tuning (optional) ----------
WATCH_REGION=US
MIN_YEAR=1980
MIN_RATINGS=300
TOP_K=50
MAX_MOVIES=9000
TMDB_POPULAR_PAGES=10
TMDB_TV_PAGES=8
REDDIT_MAX_POSTS=400
MAX_ARTIFACT_MB=20
CURATORS_ENABLED=true
# MOVIELENS_DIR=data/raw/ml-32m
# GENOME_DIR=data/raw/ml-25m   # optional tag genome (genome-scores.csv)

# ---------- Supabase Edge Function secrets (set with `supabase secrets set`, not here) ----------
# TMDB_API_KEY=...            (same key as the pipeline)
# ALLOWED_ORIGINS=https://<user>.github.io,http://localhost:3000
# PROXY_RATE_LIMIT=120        (requests per user per hour)
# WATCH_REGION=US
